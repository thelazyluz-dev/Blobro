{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // Widened so the Worker can import the shared, DOM-free game core straight
  // from ../src/game — see worker/src/rules.ts. Do NOT narrow this back to
  // "src" only; that would silently stop typechecking the shared imports.
  "include": ["src", "../src/game/**/*.ts"],
  // *.test.ts files pull in vitest types the Worker project doesn't have —
  // they're covered by the root project's typecheck instead.
  "exclude": ["node_modules", "../src/game/**/*.test.ts"]
}
